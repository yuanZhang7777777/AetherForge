# ===== DeepSeek 文本模型（N2 汇总判定 / N4 设计 / N5 编译） =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PROMPT_MODEL=deepseek-v4-flash
# 可选更强设计模型（默认为 DEEPSEEK_PROMPT_MODEL）
DEEPSEEK_DESIGN_MODEL=

# ===== APIMart（视觉识别 + 生图） =====
APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai/v1
APIMART_VISION_MODEL=gpt-5-nano-2025-08-07
APIMART_IMAGE_MODEL=gpt-image-2

# ===== OSS 存储（P3 使用；本地先用 local 目录） =====
STORAGE_BACKEND=local
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=aetherforge

# ===== ERP 登录（员工登录走 ERP，首次登录自动建号） =====
# 配置后登录页改为 ERP 用户名/密码；未配置则回退本地账号密码
ERP_LOGIN_URL=
# 管理员名单（逗号分隔），命中者登录后角色为 admin，否则 operator
PLATFORM_ADMIN_ERP_USERS=
# ERP 接口超时（秒）
CATALOG_TIMEOUT_SECONDS=15
# ERP 商品目录查询接口（queryGoodsSales）
CATALOG_QUERY_URL=
# 商品图片下载域名白名单（逗号分隔，SSRF 防护；报「商品图片无法导入」时按日志补 ERP 图片域名）
CATALOG_ALLOWED_IMAGE_HOSTS=

# ===== 运行参数 =====
# 1 = 不真实调用模型，用本地样例跑通结构（无密钥也能验证链路）
OFFLINE_MODE=0
PROMPT_TIMEOUT_SECONDS=180
# N2/N4 深度思考档位（low/high/max）；N5 编译档位
REASONING_EFFORT_DEEP=high
REASONING_EFFORT_COMPILE=low
MAX_TOKENS_DEEP=16384
MAX_TOKENS_COMPILE=8192

# ===== 部署（compose 三服务共享；本地开发默认 sqlite，无需设置） =====
# 数据库连接（compose 内会自动覆盖为 postgres，无需手填）
DATABASE_URL=sqlite:///./aetherforge.db
# 会话签名密钥（生产必填随机长串）
SESSION_SECRET=
# 并发生图上限（generation-worker 并发提交数）
MAX_ACTIVE_GENERATIONS=16
# 单用户每日出图配额
USER_DAILY_GENERATION_LIMIT=100
# 初始管理员（web 启动自动种子）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@aetherforge.local
# 对外端口（默认 18084）
AETHERFORGE_PORT=18084
# 容器内共享媒体根目录（compose 挂载 ./media:/data/media）
AETHERFORGE_MEDIA_ROOT=/data/media
# postgres 密码（compose 用）
POSTGRES_PASSWORD=
